{
  "id": "server",
  "name": {
    "en": "Dockhand Server"
  },
  "class": "other",
  "capabilities": [
    "alarm_generic",
    "measure_containers_running",
    "measure_containers_total"
  ],
  "capabilitiesOptions": {
    "alarm_generic": {
      "title": {
        "en": "Server Offline"
      },
      "insightsTitleTrue": {
        "en": "Server went offline"
      },
      "insightsTitleFalse": {
        "en": "Server came online"
      }
    }
  },
  "energy": {
    "approximation": {
      "usageConstant": 0
    }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": {
    "small": "./drivers/server/assets/images/small.png",
    "large": "./drivers/server/assets/images/large.png",
    "xlarge": "./drivers/server/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "instructions",
      "navigation": { "next": "login" }
    },
    {
      "id": "login",
      "navigation": { "next": "list_devices" }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "url",
      "type": "text",
      "label": {
        "en": "Dockhand URL"
      },
      "value": "http://dockhand:3000",
      "hint": {
        "en": "The URL of your Dockhand instance, e.g. http://192.168.1.100:3000"
      }
    },
    {
      "id": "username",
      "type": "text",
      "label": {
        "en": "Username"
      },
      "value": "",
      "hint": {
        "en": "Your Dockhand username. Leave empty if authentication is disabled."
      }
    },
    {
      "id": "password",
      "type": "password",
      "label": {
        "en": "Password"
      },
      "value": "",
      "hint": {
        "en": "Your Dockhand password. Leave empty if authentication is disabled."
      }
    },
    {
      "id": "endpoint_id",
      "type": "number",
      "label": {
        "en": "Environment ID"
      },
      "value": 1,
      "hint": {
        "en": "The Dockhand environment ID. Check your Dockhand settings or select during pairing."
      }
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (seconds)"
      },
      "value": 30,
      "hint": {
        "en": "How often to refresh container data. Minimum 10 seconds."
      }
    }
  ]
}
